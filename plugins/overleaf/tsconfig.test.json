{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-tests",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "vitest.config.ts"],
  "references": [{ "path": "./tsconfig.build.json" }]
}
